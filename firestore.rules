rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function coupleExists(coupleId) { return exists(/databases/$(database)/documents/couples/$(coupleId)); }
    function isMember(coupleId) {
      return signedIn() && coupleExists(coupleId)
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid);
      allow delete: if false;
    }

    match /pair_codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.coupleId is string;
      allow update, delete: if false;
    }

    match /couples/{coupleId} {
      allow create: if signedIn()
        && request.resource.data.memberIds.size() == 1
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.person1.uid == request.auth.uid;
      allow read: if isMember(coupleId);
      allow update: if (
        isMember(coupleId)
        || (
          signedIn()
          && request.resource.data.memberIds.size() == 2
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.person2.uid == request.auth.uid
          && get(/databases/$(database)/documents/pair_codes/$(request.resource.data.pairCode)).data.coupleId == coupleId
        )
      );
      allow delete: if false;

      match /reactions/{reactionId} {
        allow create: if isMember(coupleId)
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid in get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
        allow read: if isMember(coupleId);
        allow update, delete: if false;
      }

      match /memories/{memoryId} {
        allow read, create, update, delete: if isMember(coupleId);
      }

      match /bucket_items/{itemId} {
        allow read, create, update, delete: if isMember(coupleId);
      }

      match /canvas/{canvasId} {
        allow read, create, update: if isMember(coupleId);
        allow delete: if false;
      }
    }
  }
}
